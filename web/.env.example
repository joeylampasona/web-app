# Copy to web/.env.local and fill in from your Supabase project:
# Supabase dashboard -> Project Settings -> API.
#
# Both are NEXT_PUBLIC_, which means they are compiled into the pages and
# visible to anyone who opens the site. That is correct for these two: the URL
# names the project and the anon key identifies the project, not a person.
# Every table is behind row-level security keyed on the signed-in user, so this
# key on its own reads and writes nothing (supabase/schema.sql).
#
# Never put the service_role key here, or anywhere in web/. It bypasses every
# policy, and NEXT_PUBLIC_ would publish it.
#
# Leave both unset and the site runs exactly as it did before accounts existed:
# everything open, the four gated features closed, and the sign-up sheet saying
# so instead of collecting an address it cannot mail.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------- payments
#
# These are server-side only. None of them carries a NEXT_PUBLIC_ prefix, and
# none of them may ever be given one: the prefix compiles a value into the
# pages, and three of the four below would hand away the whole account.
#
# Set them in Vercel's environment box, not in a file that could be committed.
# Vercel bakes environment variables at build time, so adding one to a running
# deployment changes nothing until the next deploy.

# Supabase service_role. Bypasses every row-level security policy in the
# database, including the one that stops a signed-in user granting themselves
# a subscription. The Stripe webhook is the only thing that uses it, because
# the webhook is the only thing that may write an entitlement.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key. sk_test_ while testing, sk_live_ at launch. The key needs
# only the "Recurring subscriptions and billing" permission set: this site
# creates checkout sessions and reads subscriptions, and does nothing else.
STRIPE_SECRET_KEY=

# The two recurring prices. Test mode and live mode have SEPARATE ids — a live
# price id does not exist in test mode and checkout fails with "No such price".
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# From Stripe -> Developers -> Webhooks, after adding the endpoint at
# /api/stripe/webhook. Without it the webhook refuses every request, which is
# the correct behaviour: unsigned, it cannot tell Stripe from anyone else who
# has found the URL.
STRIPE_WEBHOOK_SECRET=

# Where checkout returns to. Must be the real origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://thetape.cc
